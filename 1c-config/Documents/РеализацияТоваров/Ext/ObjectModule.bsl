Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
    Для Каждого Строка Из Товары Цикл
        Строка.Сумма = Строка.Количество * Строка.Цена;
    КонецЦикла;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения) 
	    Если ЗначениеЗаполнено(Заказ) Тогда
        ЗапросДубля = Новый Запрос;
        ЗапросДубля.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ 1
        |    Реализация.Ссылка КАК Ссылка
        |ИЗ
        |    Документ.РеализацияТоваров КАК Реализация
        |ГДЕ
        |    Реализация.Заказ = &Заказ
        |    И Реализация.Проведен
        |    И Реализация.Ссылка <> &ТекущаяСсылка";
        ЗапросДубля.УстановитьПараметр("Заказ", Заказ);
        ЗапросДубля.УстановитьПараметр("ТекущаяСсылка", Ссылка);

        Если Не ЗапросДубля.Выполнить().Пустой() Тогда
            ВызватьИсключение "По этому заказу уже есть проведённая реализация.";
        КонецЕсли;
	КонецЕсли;
	
    Для Каждого Строка Из Товары Цикл
        Движение = Движения.ОстаткиТоваров.Добавить();
        Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
        Движение.Период = Дата;
        Движение.Номенклатура = Строка.Номенклатура;
        Движение.Склады = Склад;
        Движение.Количество = Строка.Количество;
	КонецЦикла; 
	
	 Движения.Взаиморасчеты.Записывать = Истина;
    ДвижениеРасчетов = Движения.Взаиморасчеты.Добавить();
    ДвижениеРасчетов.ВидДвижения = ВидДвиженияНакопления.Приход;
    ДвижениеРасчетов.Период = Дата;
    ДвижениеРасчетов.Контрагент = Покупатель;
    ДвижениеРасчетов.Сумма = Товары.Итог("Сумма");

    Движения.ОстаткиТоваров.Записывать = Истина;
    Движения.Записать();

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Остатки.Номенклатура КАК Номенклатура,
    |    Остатки.КоличествоОстаток КАК КоличествоОстаток
    |ИЗ
    |    РегистрНакопления.ОстаткиТоваров.Остатки(, Склады = &Склад) КАК Остатки
    |ГДЕ
    |    Остатки.КоличествоОстаток < 0";
    Запрос.УстановитьПараметр("Склад", Склад);

    Выборка = Запрос.Выполнить().Выбрать();
    ТекстОшибки = "";
    Пока Выборка.Следующий() Цикл
        ТекстОшибки = ТекстОшибки + "Не хватает товара " + Выборка.Номенклатура
            + ", превышение: " + (-Выборка.КоличествоОстаток) + Символы.ПС;
    КонецЦикла;

    Если ТекстОшибки <> "" Тогда
        ВызватьИсключение ТекстОшибки;
	КонецЕсли; 

    Если ЗначениеЗаполнено(Заказ) Тогда
        ЗаказОбъект = Заказ.ПолучитьОбъект();
        ЗаказОбъект.Статус = Перечисления.СтатусыЗаказа.Выполнен;
        ЗаказОбъект.Записать();
    КонецЕсли;
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		Покупатель = ДанныеЗаполнения.Покупатель;
		Склад = ДанныеЗаполнения.Склад;
		Заказ = ДанныеЗаполнения.Ссылка;
		Для Каждого ТекСтрокаТовары Из ДанныеЗаполнения.Товары Цикл
			НоваяСтрока = Товары.Добавить();
			НоваяСтрока.Количество = ТекСтрокаТовары.Количество;
			НоваяСтрока.Номенклатура = ТекСтрокаТовары.Номенклатура;
			НоваяСтрока.Сумма = ТекСтрокаТовары.Сумма;
			НоваяСтрока.Цена = ТекСтрокаТовары.Цена;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры    


