Функция CatalogGET(Запрос)
    Попытка
        // 1. Остатки по товарам (суммируем по всем складам)
        ЗапросОстатков = Новый Запрос;
        ЗапросОстатков.Текст =
        "ВЫБРАТЬ
        |    Ост.Номенклатура КАК Номенклатура,
        |    Ост.КоличествоОстаток КАК Количество
        |ИЗ
        |    РегистрНакопления.ОстаткиТоваров.Остатки КАК Ост";
        ВыборкаОстатков = ЗапросОстатков.Выполнить().Выбрать();

        ОстаткиПоТоварам = Новый Соответствие;
        Пока ВыборкаОстатков.Следующий() Цикл
            Текущее = ОстаткиПоТоварам.Получить(ВыборкаОстатков.Номенклатура);
            ОстаткиПоТоварам.Вставить(
                ВыборкаОстатков.Номенклатура,
                ?(Текущее = Неопределено, 0, Текущее) + ВыборкаОстатков.Количество);
        КонецЦикла;

        // 2. Товары
        ЗапросТоваров = Новый Запрос;
        ЗапросТоваров.Текст =
        "ВЫБРАТЬ
        |    Номенклатура.Ссылка КАК Ссылка,
        |    Номенклатура.Артикул КАК Артикул,
        |    Номенклатура.Наименование КАК Наименование,
        |    Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
        |    Номенклатура.ЦенаПродажи КАК Цена,
        |    Номенклатура.Описание КАК Описание
        |ИЗ
        |    Справочник.Номенклатура КАК Номенклатура
        |УПОРЯДОЧИТЬ ПО
        |    Номенклатура.Артикул";
        Выборка = ЗапросТоваров.Выполнить().Выбрать();

        Запись = Новый ЗаписьJSON;
        Запись.УстановитьСтроку();
        Запись.ЗаписатьНачалоМассива();
        Пока Выборка.Следующий() Цикл
            Остаток = ОстаткиПоТоварам.Получить(Выборка.Ссылка);
            Если Остаток = Неопределено Тогда
                Остаток = 0;
            КонецЕсли;

            Запись.ЗаписатьНачалоОбъекта();
            Запись.ЗаписатьИмяСвойства("sku");
            Запись.ЗаписатьЗначение(Выборка.Артикул);
            Запись.ЗаписатьИмяСвойства("name");
            Запись.ЗаписатьЗначение(СокрЛП(Выборка.Наименование));
            Запись.ЗаписатьИмяСвойства("unit");
            Запись.ЗаписатьЗначение(Выборка.ЕдиницаИзмерения);
            Запись.ЗаписатьИмяСвойства("price");
            Запись.ЗаписатьЗначение(Выборка.Цена);
            Запись.ЗаписатьИмяСвойства("description");
            Запись.ЗаписатьЗначение(Выборка.Описание);
            Запись.ЗаписатьИмяСвойства("stock");
            Запись.ЗаписатьЗначение(Остаток);
            Запись.ЗаписатьКонецОбъекта();
        КонецЦикла;
        Запись.ЗаписатьКонецМассива();

        Ответ = Новый HTTPСервисОтвет(200);
        Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
        Ответ.УстановитьТелоИзСтроки(Запись.Закрыть());
        Возврат Ответ;
    Исключение
        Ответ = Новый HTTPСервисОтвет(500);
        Ответ.УстановитьТелоИзСтроки(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
        Возврат Ответ;
    КонецПопытки;
КонецФункции