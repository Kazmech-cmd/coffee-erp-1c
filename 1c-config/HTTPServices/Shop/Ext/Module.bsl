Функция CatalogGET(Запрос)
    Попытка
        // 1. Остатки по товарам (суммируем по всем складам)
        ЗапросОстатков = Новый Запрос;
        ЗапросОстатков.Текст =
        "ВЫБРАТЬ
        |    Ост.Номенклатура КАК Номенклатура,
        |    Ост.КоличествоОстаток КАК Количество
        |ИЗ
        |    РегистрНакопления.ОстаткиТоваров.Остатки КАК Ост";
        ВыборкаОстатков = ЗапросОстатков.Выполнить().Выбрать();

        ОстаткиПоТоварам = Новый Соответствие;
        Пока ВыборкаОстатков.Следующий() Цикл
            Текущее = ОстаткиПоТоварам.Получить(ВыборкаОстатков.Номенклатура);
            ОстаткиПоТоварам.Вставить(
                ВыборкаОстатков.Номенклатура,
                ?(Текущее = Неопределено, 0, Текущее) + ВыборкаОстатков.Количество);
        КонецЦикла;

        // 2. Товары
        ЗапросТоваров = Новый Запрос;
        ЗапросТоваров.Текст =
        "ВЫБРАТЬ
        |    Номенклатура.Ссылка КАК Ссылка,
        |    Номенклатура.Артикул КАК Артикул,
        |    Номенклатура.Наименование КАК Наименование,
        |    Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
        |    Номенклатура.ЦенаПродажи КАК Цена,
        |    Номенклатура.Описание КАК Описание
        |ИЗ
        |    Справочник.Номенклатура КАК Номенклатура
        |УПОРЯДОЧИТЬ ПО
        |    Номенклатура.Артикул";
        Выборка = ЗапросТоваров.Выполнить().Выбрать();

        Запись = Новый ЗаписьJSON;
        Запись.УстановитьСтроку();
        Запись.ЗаписатьНачалоМассива();
        Пока Выборка.Следующий() Цикл
            Остаток = ОстаткиПоТоварам.Получить(Выборка.Ссылка);
            Если Остаток = Неопределено Тогда
                Остаток = 0;
            КонецЕсли;

            Запись.ЗаписатьНачалоОбъекта();
            Запись.ЗаписатьИмяСвойства("sku");
            Запись.ЗаписатьЗначение(Выборка.Артикул);
            Запись.ЗаписатьИмяСвойства("name");
            Запись.ЗаписатьЗначение(СокрЛП(Выборка.Наименование));
            Запись.ЗаписатьИмяСвойства("unit");
            Запись.ЗаписатьЗначение(Выборка.ЕдиницаИзмерения);
            Запись.ЗаписатьИмяСвойства("price");
            Запись.ЗаписатьЗначение(Выборка.Цена);
            Запись.ЗаписатьИмяСвойства("description");
            Запись.ЗаписатьЗначение(Выборка.Описание);
            Запись.ЗаписатьИмяСвойства("stock");
            Запись.ЗаписатьЗначение(Остаток);
            Запись.ЗаписатьКонецОбъекта();
        КонецЦикла;
        Запись.ЗаписатьКонецМассива();

        Ответ = Новый HTTPСервисОтвет(200);
        Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
        Ответ.УстановитьТелоИзСтроки(Запись.Закрыть());
        Возврат Ответ;
    Исключение
        Ответ = Новый HTTPСервисОтвет(500);
        Ответ.УстановитьТелоИзСтроки(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
        Возврат Ответ;
    КонецПопытки;
КонецФункции

Функция ОтветJSON(КодСостояния, Данные)
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Данные);
    Ответ = Новый HTTPСервисОтвет(КодСостояния);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Ответ.УстановитьТелоИзСтроки(Запись.Закрыть());
    Возврат Ответ;
КонецФункции

Функция ОтветОшибка(КодСостояния, Текст)
    Возврат ОтветJSON(КодСостояния, Новый Структура("error", Текст));
КонецФункции

Функция ТекстовоеПоле(Данные, Ключ)
    Значение = Данные.Получить(Ключ);
    Если Значение = Неопределено Или ТипЗнч(Значение) = Тип("Null") Тогда
        Возврат "";
    КонецЕсли;
    Возврат СокрЛП(Строка(Значение));
КонецФункции

Функция ОстатокТовара(Номенклатура, Склад)
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    ЕСТЬNULL(СУММА(Остатки.КоличествоОстаток), 0) КАК Количество
    |ИЗ
    |    РегистрНакопления.ОстаткиТоваров.Остатки(, Номенклатура = &Номенклатура И Склады = &Склад) КАК Остатки";
    Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
    Запрос.УстановитьПараметр("Склад", Склад);
    Выборка = Запрос.Выполнить().Выбрать();
    Выборка.Следующий();
    Возврат Выборка.Количество;
КонецФункции

Функция НайтиИлиСоздатьПокупателя(Имя, Email, Телефон, Адрес)
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Контрагенты.Ссылка КАК Ссылка
    |ИЗ
    |    Справочник.Контрагенты КАК Контрагенты
    |ГДЕ
    |    Контрагенты.Email = &Email
    |    И Контрагенты.Покупатель";
    Запрос.УстановитьПараметр("Email", Email);
    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        Возврат Выборка.Ссылка;
    КонецЕсли;

    НовыйКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
    НовыйКонтрагент.Наименование = Лев(Имя, Метаданные.Справочники.Контрагенты.ДлинаНаименования);
    НовыйКонтрагент.Покупатель = Истина;
    НовыйКонтрагент.Email = Лев(Email, 100);
    НовыйКонтрагент.Телефон = Лев(Телефон, 20);
    НовыйКонтрагент.АдресДоставки = Лев(Адрес, 200);
    НовыйКонтрагент.Записать();
    Возврат НовыйКонтрагент.Ссылка;
КонецФункции

Функция OrdersPOST(Запрос)
    Попытка
        Чтение = Новый ЧтениеJSON;
        Чтение.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку());
        Данные = ПрочитатьJSON(Чтение, Истина);
        Чтение.Закрыть();
    Исключение
        Возврат ОтветОшибка(400, "Тело запроса не является корректным JSON.");
    КонецПопытки;

    Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
        Возврат ОтветОшибка(400, "Ожидался JSON-объект.");
    КонецЕсли;

    Клиент = Данные.Получить("customer");
    Позиции = Данные.Получить("items");
    Если ТипЗнч(Клиент) <> Тип("Соответствие") Тогда
        Возврат ОтветОшибка(400, "Не указан покупатель (customer).");
    КонецЕсли;
    Если ТипЗнч(Позиции) <> Тип("Массив") Или Позиции.Количество() = 0 Тогда
        Возврат ОтветОшибка(400, "Корзина пуста (items).");
    КонецЕсли;
    Если Позиции.Количество() > 50 Тогда
        Возврат ОтветОшибка(400, "Слишком много позиций (максимум 50).");
    КонецЕсли;

    Имя = ТекстовоеПоле(Клиент, "name");
    Email = НРег(ТекстовоеПоле(Клиент, "email"));
    Телефон = ТекстовоеПоле(Клиент, "phone");
    Адрес = ТекстовоеПоле(Клиент, "address");
    Если Имя = "" Тогда
        Возврат ОтветОшибка(400, "Не указано имя покупателя (customer.name).");
    КонецЕсли;
    Если СтрНайти(Email, "@") = 0 Тогда
        Возврат ОтветОшибка(400, "Некорректный email (customer.email).");
    КонецЕсли;
    Если Адрес = "" Тогда
        Возврат ОтветОшибка(400, "Не указан адрес доставки (customer.address).");
    КонецЕсли;

    Таблица = Новый ТаблицаЗначений;
    Таблица.Колонки.Добавить("Номенклатура");
    Таблица.Колонки.Добавить("Количество");
    Для Каждого ПозицияЗаказа Из Позиции Цикл
        Если ТипЗнч(ПозицияЗаказа) <> Тип("Соответствие") Тогда
            Возврат ОтветОшибка(400, "Каждая позиция должна быть объектом {sku, quantity}.");
        КонецЕсли;
        Артикул = ТекстовоеПоле(ПозицияЗаказа, "sku");
        Количество = ПозицияЗаказа.Получить("quantity");
        Если ТипЗнч(Количество) <> Тип("Число") Или Количество <= 0 Или Количество <> Цел(Количество) Или Количество > 1000 Тогда
            Возврат ОтветОшибка(400, "Некорректное количество для " + Артикул + " (нужно целое число от 1 до 1000).");
        КонецЕсли;
        Товар = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", Артикул);
        Если Товар.Пустая() Тогда
            Возврат ОтветОшибка(400, "Товар с артикулом " + Артикул + " не найден.");
        КонецЕсли;
        НоваяСтрокаТаблицы = Таблица.Добавить();
        НоваяСтрокаТаблицы.Номенклатура = Товар;
        НоваяСтрокаТаблицы.Количество = Количество;
    КонецЦикла;
    Таблица.Свернуть("Номенклатура", "Количество");

    Склад = Справочники.Склады.НайтиПоНаименованию("Основной склад", Истина);
    Если Склад.Пустая() Тогда
        Возврат ОтветОшибка(500, "На сервере не настроен склад для интернет-заказов.");
    КонецЕсли;

    // Предварительная проверка наличия (окончательный контроль остатков остаётся при реализации)
    Нехватка = Новый Массив;
    Для Каждого СтрокаТаблицы Из Таблица Цикл
        Остаток = ОстатокТовара(СтрокаТаблицы.Номенклатура, Склад);
        Если Остаток < СтрокаТаблицы.Количество Тогда
            Нехватка.Добавить(Новый Структура("sku, requested, available",
                СтрокаТаблицы.Номенклатура.Артикул, СтрокаТаблицы.Количество, Остаток));
        КонецЕсли;
    КонецЦикла;
    Если Нехватка.Количество() > 0 Тогда
        Возврат ОтветJSON(409, Новый Структура("error, items", "Недостаточно товара на складе.", Нехватка));
    КонецЕсли;

    НачатьТранзакцию();
    Попытка
        Покупатель = НайтиИлиСоздатьПокупателя(Имя, Email, Телефон, Адрес);
        Заказ = Документы.ЗаказПокупателя.СоздатьДокумент();
        Заказ.Дата = ТекущаяДатаСеанса();
        Заказ.Покупатель = Покупатель;
        Заказ.Склад = Склад;
        Заказ.Статус = Перечисления.СтатусыЗаказа.Новый;
        Для Каждого СтрокаТаблицы Из Таблица Цикл
            НоваяСтрока = Заказ.Товары.Добавить();
            НоваяСтрока.Номенклатура = СтрокаТаблицы.Номенклатура;
            НоваяСтрока.Количество = СтрокаТаблицы.Количество;
            НоваяСтрока.Цена = СтрокаТаблицы.Номенклатура.ЦенаПродажи;
            НоваяСтрока.Сумма = НоваяСтрока.Количество * НоваяСтрока.Цена;
        КонецЦикла;
        Заказ.Записать();
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ЗаписьЖурналаРегистрации("Shop.Orders", УровеньЖурналаРегистрации.Ошибка, , ,
            ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
        Возврат ОтветОшибка(500, "Не удалось создать заказ.");
    КонецПопытки;

    Результат = Новый Структура;
    Результат.Вставить("order_number", Заказ.Номер);
    Результат.Вставить("status", Строка(Заказ.Статус));
    Результат.Вставить("total", Заказ.Товары.Итог("Сумма"));
    Возврат ОтветJSON(201, Результат);
КонецФункции

Функция OrderByNumberGET(Запрос)
    Номер = СокрЛП(Запрос.ПараметрыURL["Number"]);
    Email = НРег(СокрЛП(Запрос.ПараметрыЗапроса["email"]));
    Если Email = "" Тогда
        Возврат ОтветОшибка(400, "Укажите email покупателя в параметре email.");
    КонецЕсли;

    ДлинаНомера = Метаданные.Документы.ЗаказПокупателя.ДлинаНомера;
    Пока СтрДлина(Номер) < ДлинаНомера Цикл
        Номер = "0" + Номер;
    КонецЦикла;

    ЗапросБД = Новый Запрос;
    ЗапросБД.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Заказы.Ссылка КАК Ссылка
    |ИЗ
    |    Документ.ЗаказПокупателя КАК Заказы
    |ГДЕ
    |    Заказы.Номер = &Номер
    |    И НЕ Заказы.ПометкаУдаления";
    ЗапросБД.УстановитьПараметр("Номер", Номер);
    Выборка = ЗапросБД.Выполнить().Выбрать();

    // Чужой email и несуществующий номер дают одинаковый ответ 404
    Если Не Выборка.Следующий() Тогда
        Возврат ОтветОшибка(404, "Заказ не найден.");
    КонецЕсли;
    Заказ = Выборка.Ссылка.ПолучитьОбъект();
    Если НРег(СокрЛП(Заказ.Покупатель.Email)) <> Email Тогда
        Возврат ОтветОшибка(404, "Заказ не найден.");
    КонецЕсли;

    Позиции = Новый Массив;
    Для Каждого СтрокаЗаказа Из Заказ.Товары Цикл
        Позиции.Добавить(Новый Структура("sku, name, quantity, price, sum",
            СтрокаЗаказа.Номенклатура.Артикул,
            СокрЛП(СтрокаЗаказа.Номенклатура.Наименование),
            СтрокаЗаказа.Количество,
            СтрокаЗаказа.Цена,
            СтрокаЗаказа.Сумма));
    КонецЦикла;

    Результат = Новый Структура;
    Результат.Вставить("order_number", Заказ.Номер);
    Результат.Вставить("date", Формат(Заказ.Дата, "ДФ=yyyy-MM-dd'T'HH:mm:ss"));
    Результат.Вставить("status", Строка(Заказ.Статус));
    Результат.Вставить("items", Позиции);
    Результат.Вставить("total", Заказ.Товары.Итог("Сумма"));
    Возврат ОтветJSON(200, Результат);
КонецФункции