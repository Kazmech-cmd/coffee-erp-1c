		<query>ВЫБРАТЬ
    Данные.Склады КАК Склады,
    Данные.Номенклатура КАК Номенклатура,
    СУММА(Данные.Остаток) КАК КоличествоОстаток,
    СУММА(Данные.Резерв) КАК Резерв,
    СУММА(Данные.Остаток - Данные.Резерв) КАК Доступно
ИЗ
    (ВЫБРАТЬ
        О.Склады КАК Склады,
        О.Номенклатура КАК Номенклатура,
        О.КоличествоОстаток КАК Остаток,
        0 КАК Резерв
    ИЗ
        РегистрНакопления.ОстаткиТоваров.Остатки КАК О

    ОБЪЕДИНИТЬ ВСЕ

    ВЫБРАТЬ
        Р.Склады,
        Р.Номенклатура,
        0,
        Р.КоличествоОстаток
    ИЗ
        РегистрНакопления.РезервыТоваров.Остатки КАК Р) КАК Данные

СГРУППИРОВАТЬ ПО
    Данные.Склады,
    Данные.Номенклатура</query>
